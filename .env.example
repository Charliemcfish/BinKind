# ============================================
# BinKind - Environment Variables Template
# ============================================
# Copy this file to .env for local development
# Add these same variables to Netlify Dashboard > Site Settings > Environment Variables

# ============================================
# GOCARDLESS CONFIGURATION
# ============================================

# Your GoCardless API Access Token
# Get this from: https://manage.gocardless.com/developers/access-tokens
GOCARDLESS_ACCESS_TOKEN=your_access_token_here

# GoCardless Environment: "Sandbox" for testing, "Live" for production
# IMPORTANT: Always start with "Sandbox" for testing!
GOCARDLESS_ENVIRONMENT=Sandbox

# GoCardless Webhook Secret (optional, but recommended for production)
# Get this from: https://manage.gocardless.com/developers/webhooks
GOCARDLESS_WEBHOOK_SECRET=your_webhook_secret_here

# ============================================
# BINKIND CONFIGURATION
# ============================================

# Email address to receive booking notifications
CLIENT_EMAIL=charlielfisher@hotmail.com

# Your Netlify site URL (no trailing slash)
# Example: https://binkind.netlify.app
SITE_URL=https://your-site.netlify.app

# ============================================
# NOTES
# ============================================
# 1. NEVER commit .env to Git - it's in .gitignore
# 2. Set all these variables in Netlify Dashboard for production
# 3. Start with Sandbox environment and test thoroughly
# 4. Switch to Live only when ready for production
