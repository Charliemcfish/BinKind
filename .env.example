# BinKind Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to Git!

# ============================================
# GoCardless Configuration
# ============================================
# Get these from: https://manage.gocardless.com/
# For testing, use Sandbox environment and sandbox credentials
# For production, use Live environment and live credentials

# Your GoCardless API access token
GOCARDLESS_ACCESS_TOKEN=your_sandbox_access_token_here

# Environment: Sandbox or Live
# Use "Sandbox" for testing, "Live" for production
GOCARDLESS_ENVIRONMENT=Sandbox

# ============================================
# Email Configuration
# ============================================
# Email address where booking notifications will be sent
# This is typically the business owner's email
CLIENT_EMAIL=charlielfisher@hotmail.com

# ============================================
# Site Configuration
# ============================================
# Your website URL (used for payment callbacks)
# Local development: http://localhost:8888
# Production: https://your-site.netlify.app
SITE_URL=http://localhost:8888

# ============================================
# Optional: Email Service Configuration
# ============================================
# If using SendGrid, Mailgun, or another email service
# Uncomment and add your API keys below

# SENDGRID_API_KEY=your_sendgrid_api_key_here
# MAILGUN_API_KEY=your_mailgun_api_key_here
# MAILGUN_DOMAIN=your_mailgun_domain_here
